# Legacy local setting; hosted downloads are staged and saved by the browser.
DOWNLOAD_DIR=C:\Users\YourUser\Downloads\YouTube Downloader
# Path to ffmpeg.exe if not on PATH (leave blank to auto-detect from PATH)
FFMPEG_PATH=
# Optional Netscape-format YouTube cookies file; keep this server-side only.
# Render Secret File example: /etc/secrets/youtube-cookies.txt
YOUTUBE_COOKIES_FILE=
# Host/port the backend listens on
HOST=127.0.0.1
PORT=8000
# Max concurrent downloads
MAX_CONCURRENT_DOWNLOADS=1
# Path to the SQLite history database
DB_PATH=backend/downloads/history.db
# Path to the SQLite analytics database
ANALYTICS_DB_PATH=backend/downloads/analytics.db
# CORS origin for the Vite dev server
# Comma-separated frontend origins (use CORS_ORIGINS in production)
CORS_ORIGINS=http://localhost:5173
# Optional hosted staging root; defaults to the OS temp directory
STAGING_DIR=

# Appwrite authentication configuration.
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=

# GitHub Releases configuration. Keep GITHUB_TOKEN backend-only.
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_TARGET_BRANCH=main
